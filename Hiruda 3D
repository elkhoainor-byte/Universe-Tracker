  <script>
    // Mobile menu
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');
    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('open');
    });
    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => navLinks.classList.remove('open'));
    });

    // Form handler (demo)
    function handleSubmit(e) {
      e.preventDefault();
      const nombre = document.getElementById('nombre').value;
      alert('¡Gracias, ' + nombre + '! Tu mensaje se ha preparado. En una web real se enviaría por email o a un CRM. Mientras tanto, escríbenos por WhatsApp o Instagram @hiruda_3d para una respuesta más rápida.');
      e.target.reset();
    }

    // Smooth active link (optional)
    const sections = document.querySelectorAll('section[id]');
    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const top = section.offsetTop - 100;
        if (scrollY >= top) current = section.getAttribute('id');
      });
      document.querySelectorAll('.nav-links a').forEach(a => {
        a.classList.remove('active');
        if (a.getAttribute('href') === '#' + current) a.classList.add('active');
      });
    });
  </script>
